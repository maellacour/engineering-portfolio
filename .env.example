# Cloudinary public cloud name — used for image/video delivery. Not secret
# (it appears in public image URLs). Required for next-cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Public site URL — used for SEO / absolute OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend). Without RESEND_API_KEY the form still submits but is
# only logged server-side (no email). CONTACT_TO defaults to the site email.
# CONTACT_FROM defaults to Resend's shared test sender, which delivers only to
# your Resend account address until you verify your own domain.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Cloudflare Turnstile (bot protection on the contact form). If unset, the form
# works without a CAPTCHA and the server skips verification. Both keys come from
# the Cloudflare dashboard (Turnstile). The site key is public; the secret isn't.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
